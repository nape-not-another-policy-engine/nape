{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "not": {},
  "$defs": {
    "sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "canonicalSemver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "packageVersion": {
      "type": "string",
      "minLength": 5,
      "maxLength": 128,
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|(?=[a-z0-9-]*[a-z])[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)(?:\\.(?:0|[1-9][0-9]*|(?=[a-z0-9-]*[a-z])[a-z0-9](?:[a-z0-9-]*[a-z0-9])?))*)?$"
    },
    "ulid": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "attestifyPurlCandidate": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^pkg:attestify/[^\\s@]+@[^\\s@]+$"
    },
    "useSelector": {
      "type": "string",
      "minLength": 1,
      "maxLength": 257,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)?$"
    },
    "publisher": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)*$"
    },
    "httpLocalhostAuthority": {
      "type": "string",
      "minLength": 11,
      "maxLength": 15,
      "pattern": "^localhost:(?:[1-9]|[1-9][0-9]{1,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$"
    },
    "httpsRegistryAuthority": {
      "type": "string",
      "minLength": 1,
      "maxLength": 259,
      "pattern": "^(?![0-9]+(?:\\.[0-9]+){3}(?::|$))(?=[^:]{1,253}(?::[0-9]{1,5})?$)[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)*(?::(?!443$)(?:[1-9]|[1-9][0-9]{1,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?$"
    },
    "repositoryCandidate": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^[a-z0-9]+(?:[./-][a-z0-9]+)*$"
    },
    "canonicalFileUriCandidate": {
      "type": "string",
      "minLength": 8,
      "maxLength": 4096,
      "pattern": "^file:///[A-Za-z0-9._~%/:-]*$"
    },
    "errorCode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "reasonTemplate": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "phase": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "producerV2": {
      "type": "object",
      "required": [
        "buildDigest",
        "name",
        "version"
      ],
      "properties": {
        "buildDigest": {
          "$ref": "#/$defs/sha256Digest"
        },
        "name": {
          "const": "nape"
        },
        "qualification": {
          "const": "attestify-verification-engine-oci-development-mvp-i4"
        },
        "version": {
          "$ref": "#/$defs/canonicalSemver"
        }
      },
      "unevaluatedProperties": false
    },
    "diagnosticV2": {
      "type": "object",
      "required": [
        "code",
        "phase",
        "reason_template"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/errorCode"
        },
        "phase": {
          "$ref": "#/$defs/phase"
        },
        "reason_template": {
          "$ref": "#/$defs/reasonTemplate"
        }
      },
      "unevaluatedProperties": false
    },
    "httpTagLocationV2": {
      "type": "object",
      "required": [
        "profileVersion",
        "publisher",
        "reference",
        "referenceClass",
        "registry",
        "repository",
        "scheme"
      ],
      "properties": {
        "profileVersion": {
          "const": "attestify-oci-registry-map/1"
        },
        "publisher": {
          "$ref": "#/$defs/publisher"
        },
        "reference": {
          "$ref": "#/$defs/packageVersion"
        },
        "referenceClass": {
          "const": "tag"
        },
        "registry": {
          "$ref": "#/$defs/httpLocalhostAuthority"
        },
        "repository": {
          "$ref": "#/$defs/repositoryCandidate"
        },
        "scheme": {
          "const": "http"
        }
      },
      "unevaluatedProperties": false
    },
    "httpsTagLocationV2": {
      "type": "object",
      "required": [
        "profileVersion",
        "publisher",
        "reference",
        "referenceClass",
        "registry",
        "repository",
        "scheme"
      ],
      "properties": {
        "profileVersion": {
          "const": "attestify-oci-registry-map/1"
        },
        "publisher": {
          "$ref": "#/$defs/publisher"
        },
        "reference": {
          "$ref": "#/$defs/packageVersion"
        },
        "referenceClass": {
          "const": "tag"
        },
        "registry": {
          "$ref": "#/$defs/httpsRegistryAuthority"
        },
        "repository": {
          "$ref": "#/$defs/repositoryCandidate"
        },
        "scheme": {
          "const": "https"
        }
      },
      "unevaluatedProperties": false
    },
    "httpDigestLocationV2": {
      "type": "object",
      "required": [
        "profileVersion",
        "publisher",
        "reference",
        "referenceClass",
        "registry",
        "repository",
        "scheme"
      ],
      "properties": {
        "profileVersion": {
          "const": "attestify-oci-registry-map/1"
        },
        "publisher": {
          "$ref": "#/$defs/publisher"
        },
        "reference": {
          "$ref": "#/$defs/sha256Digest"
        },
        "referenceClass": {
          "const": "digest"
        },
        "registry": {
          "$ref": "#/$defs/httpLocalhostAuthority"
        },
        "repository": {
          "$ref": "#/$defs/repositoryCandidate"
        },
        "scheme": {
          "const": "http"
        }
      },
      "unevaluatedProperties": false
    },
    "httpsDigestLocationV2": {
      "type": "object",
      "required": [
        "profileVersion",
        "publisher",
        "reference",
        "referenceClass",
        "registry",
        "repository",
        "scheme"
      ],
      "properties": {
        "profileVersion": {
          "const": "attestify-oci-registry-map/1"
        },
        "publisher": {
          "$ref": "#/$defs/publisher"
        },
        "reference": {
          "$ref": "#/$defs/sha256Digest"
        },
        "referenceClass": {
          "const": "digest"
        },
        "registry": {
          "$ref": "#/$defs/httpsRegistryAuthority"
        },
        "repository": {
          "$ref": "#/$defs/repositoryCandidate"
        },
        "scheme": {
          "const": "https"
        }
      },
      "unevaluatedProperties": false
    },
    "tagLocationV2": {
      "oneOf": [
        {
          "$ref": "#/$defs/httpTagLocationV2"
        },
        {
          "$ref": "#/$defs/httpsTagLocationV2"
        }
      ]
    },
    "digestLocationV2": {
      "oneOf": [
        {
          "$ref": "#/$defs/httpDigestLocationV2"
        },
        {
          "$ref": "#/$defs/httpsDigestLocationV2"
        }
      ]
    },
    "packageBuildResultV2": {
      "type": "object",
      "required": [
        "integrity",
        "manifestDigest",
        "output",
        "package",
        "trust"
      ],
      "properties": {
        "integrity": {
          "const": "digest-verified"
        },
        "manifestDigest": {
          "$ref": "#/$defs/sha256Digest"
        },
        "output": {
          "$ref": "#/$defs/canonicalFileUriCandidate"
        },
        "package": {
          "$ref": "#/$defs/attestifyPurlCandidate"
        },
        "trust": {
          "const": "not-evaluated"
        }
      },
      "unevaluatedProperties": false
    },
    "packagePublishResultV2": {
      "type": "object",
      "required": [
        "disposition",
        "integrity",
        "location",
        "manifestDigest",
        "package",
        "trust"
      ],
      "properties": {
        "disposition": {
          "enum": [
            "already-present",
            "published"
          ]
        },
        "integrity": {
          "const": "digest-verified"
        },
        "location": {
          "$ref": "#/$defs/tagLocationV2"
        },
        "manifestDigest": {
          "$ref": "#/$defs/sha256Digest"
        },
        "package": {
          "$ref": "#/$defs/attestifyPurlCandidate"
        },
        "trust": {
          "const": "not-evaluated"
        }
      },
      "unevaluatedProperties": false
    },
    "resolveRootV2": {
      "type": "object",
      "required": [
        "disposition",
        "integrity",
        "location",
        "manifestDigest",
        "package",
        "trust"
      ],
      "properties": {
        "disposition": {
          "const": "verified"
        },
        "integrity": {
          "const": "digest-verified"
        },
        "location": {
          "$ref": "#/$defs/digestLocationV2"
        },
        "manifestDigest": {
          "$ref": "#/$defs/sha256Digest"
        },
        "package": {
          "$ref": "#/$defs/attestifyPurlCandidate"
        },
        "trust": {
          "const": "not-evaluated"
        }
      },
      "unevaluatedProperties": false
    },
    "resolveLockV2": {
      "type": "object",
      "required": [
        "lockVersion",
        "profileVersion",
        "validation"
      ],
      "properties": {
        "lockVersion": {
          "const": "1"
        },
        "profileVersion": {
          "const": "attestify-oci-repository-profile/1"
        },
        "validation": {
          "const": "passed"
        }
      },
      "unevaluatedProperties": false
    },
    "resolveDependencyV2": {
      "type": "object",
      "required": [
        "disposition",
        "from",
        "location",
        "manifestDigest",
        "package",
        "use"
      ],
      "properties": {
        "disposition": {
          "const": "planned-not-acquired"
        },
        "location": {
          "$ref": "#/$defs/digestLocationV2"
        },
        "manifestDigest": {
          "$ref": "#/$defs/sha256Digest"
        },
        "package": {
          "$ref": "#/$defs/attestifyPurlCandidate"
        },
        "use": {
          "$ref": "#/$defs/useSelector"
        },
        "from": {
          "$ref": "#/$defs/attestifyPurlCandidate"
        }
      },
      "unevaluatedProperties": false
    },
    "packageResolvePlanResultV2": {
      "type": "object",
      "required": [
        "dependency",
        "lock",
        "root"
      ],
      "properties": {
        "dependency": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resolveDependencyV2"
          },
          "minItems": 0,
          "maxItems": 2
        },
        "lock": {
          "$ref": "#/$defs/resolveLockV2"
        },
        "root": {
          "$ref": "#/$defs/resolveRootV2"
        }
      },
      "unevaluatedProperties": false
    },
    "verificationReportProjectionV2": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "summary"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/ulid"
        },
        "kind": {
          "const": "VerificationReport"
        },
        "summary": {
          "$ref": "#/$defs/verificationReportSummaryV2"
        }
      },
      "unevaluatedProperties": false
    },
    "localAcquisitionV2": {
      "type": "object",
      "required": [
        "binding",
        "integrity",
        "source",
        "trust"
      ],
      "properties": {
        "binding": {
          "const": "local-build-result"
        },
        "integrity": {
          "const": "digest-verified"
        },
        "source": {
          "const": "local-build"
        },
        "trust": {
          "const": "not-evaluated"
        }
      },
      "unevaluatedProperties": false
    },
    "ociAcquisitionV2": {
      "type": "object",
      "required": [
        "binding",
        "integrity",
        "source",
        "trust"
      ],
      "properties": {
        "binding": {
          "const": "invocation"
        },
        "integrity": {
          "const": "digest-verified"
        },
        "source": {
          "const": "oci-pull"
        },
        "trust": {
          "const": "not-evaluated"
        }
      },
      "unevaluatedProperties": false
    },
    "verificationAcquisitionV2": {
      "oneOf": [
        {
          "$ref": "#/$defs/localAcquisitionV2"
        },
        {
          "$ref": "#/$defs/ociAcquisitionV2"
        }
      ]
    },
    "verificationProcedureProjectionV2": {
      "type": "object",
      "required": [
        "acquisition",
        "manifestDigest",
        "package"
      ],
      "properties": {
        "acquisition": {
          "$ref": "#/$defs/verificationAcquisitionV2"
        },
        "manifestDigest": {
          "$ref": "#/$defs/sha256Digest"
        },
        "package": {
          "$ref": "#/$defs/attestifyPurlCandidate"
        }
      },
      "unevaluatedProperties": false
    },
    "verifyResultV2": {
      "type": "object",
      "required": [
        "output",
        "procedure",
        "report"
      ],
      "properties": {
        "output": {
          "$ref": "#/$defs/canonicalFileUriCandidate"
        },
        "procedure": {
          "$ref": "#/$defs/verificationProcedureProjectionV2"
        },
        "report": {
          "$ref": "#/$defs/verificationReportProjectionV2"
        }
      },
      "unevaluatedProperties": false
    },
    "packageBuildSucceededReceiptV2": {
      "type": "object",
      "required": [
        "command",
        "contract",
        "producer",
        "result",
        "status"
      ],
      "properties": {
        "command": {
          "const": "package-build"
        },
        "contract": {
          "const": "attestify.nape.command-receipt/v2"
        },
        "producer": {
          "$ref": "#/$defs/producerV2"
        },
        "result": {
          "$ref": "#/$defs/packageBuildResultV2"
        },
        "status": {
          "const": "succeeded"
        }
      },
      "unevaluatedProperties": false
    },
    "packagePublishSucceededReceiptV2": {
      "type": "object",
      "required": [
        "command",
        "contract",
        "producer",
        "result",
        "status"
      ],
      "properties": {
        "command": {
          "const": "package-publish"
        },
        "contract": {
          "const": "attestify.nape.command-receipt/v2"
        },
        "producer": {
          "$ref": "#/$defs/producerV2"
        },
        "result": {
          "$ref": "#/$defs/packagePublishResultV2"
        },
        "status": {
          "const": "succeeded"
        }
      },
      "unevaluatedProperties": false
    },
    "packageResolvePlanSucceededReceiptV2": {
      "type": "object",
      "required": [
        "command",
        "contract",
        "producer",
        "result",
        "status"
      ],
      "properties": {
        "command": {
          "const": "package-resolve-plan"
        },
        "contract": {
          "const": "attestify.nape.command-receipt/v2"
        },
        "producer": {
          "$ref": "#/$defs/producerV2"
        },
        "result": {
          "$ref": "#/$defs/packageResolvePlanResultV2"
        },
        "status": {
          "const": "succeeded"
        }
      },
      "unevaluatedProperties": false
    },
    "verifySucceededReceiptV2": {
      "type": "object",
      "required": [
        "command",
        "contract",
        "producer",
        "result",
        "status"
      ],
      "properties": {
        "command": {
          "const": "verify"
        },
        "contract": {
          "const": "attestify.nape.command-receipt/v2"
        },
        "producer": {
          "$ref": "#/$defs/producerV2"
        },
        "result": {
          "$ref": "#/$defs/verifyResultV2"
        },
        "status": {
          "const": "succeeded"
        }
      },
      "unevaluatedProperties": false
    },
    "packageBuildFailedReceiptV2": {
      "type": "object",
      "required": [
        "command",
        "contract",
        "diagnostic",
        "producer",
        "status"
      ],
      "properties": {
        "command": {
          "const": "package-build"
        },
        "contract": {
          "const": "attestify.nape.command-receipt/v2"
        },
        "diagnostic": {
          "$ref": "#/$defs/diagnosticV2"
        },
        "producer": {
          "$ref": "#/$defs/producerV2"
        },
        "status": {
          "const": "failed"
        }
      },
      "unevaluatedProperties": false
    },
    "packagePublishFailedReceiptV2": {
      "type": "object",
      "required": [
        "command",
        "contract",
        "diagnostic",
        "producer",
        "status"
      ],
      "properties": {
        "command": {
          "const": "package-publish"
        },
        "contract": {
          "const": "attestify.nape.command-receipt/v2"
        },
        "diagnostic": {
          "$ref": "#/$defs/diagnosticV2"
        },
        "producer": {
          "$ref": "#/$defs/producerV2"
        },
        "status": {
          "const": "failed"
        }
      },
      "unevaluatedProperties": false
    },
    "packageResolvePlanFailedReceiptV2": {
      "type": "object",
      "required": [
        "command",
        "contract",
        "diagnostic",
        "producer",
        "status"
      ],
      "properties": {
        "command": {
          "const": "package-resolve-plan"
        },
        "contract": {
          "const": "attestify.nape.command-receipt/v2"
        },
        "diagnostic": {
          "$ref": "#/$defs/diagnosticV2"
        },
        "producer": {
          "$ref": "#/$defs/producerV2"
        },
        "status": {
          "const": "failed"
        }
      },
      "unevaluatedProperties": false
    },
    "verifyFailedReceiptV2": {
      "type": "object",
      "required": [
        "command",
        "contract",
        "diagnostic",
        "invocationId",
        "producer",
        "source",
        "status"
      ],
      "properties": {
        "command": {
          "const": "verify"
        },
        "contract": {
          "const": "attestify.nape.command-receipt/v2"
        },
        "diagnostic": {
          "$ref": "#/$defs/diagnosticV2"
        },
        "invocationId": {
          "$ref": "#/$defs/ulid"
        },
        "producer": {
          "$ref": "#/$defs/producerV2"
        },
        "source": {
          "enum": [
            "local-package",
            "oci-registry"
          ]
        },
        "status": {
          "const": "failed"
        }
      },
      "unevaluatedProperties": false
    },
    "napeCommandReceiptV2": {
      "oneOf": [
        {
          "$ref": "#/$defs/packageBuildSucceededReceiptV2"
        },
        {
          "$ref": "#/$defs/packagePublishSucceededReceiptV2"
        },
        {
          "$ref": "#/$defs/packageResolvePlanSucceededReceiptV2"
        },
        {
          "$ref": "#/$defs/verifySucceededReceiptV2"
        },
        {
          "$ref": "#/$defs/packageBuildFailedReceiptV2"
        },
        {
          "$ref": "#/$defs/packagePublishFailedReceiptV2"
        },
        {
          "$ref": "#/$defs/packageResolvePlanFailedReceiptV2"
        },
        {
          "$ref": "#/$defs/verifyFailedReceiptV2"
        }
      ]
    },
    "verificationReportSummaryV2": {
      "type": "object",
      "required": [
        "activity_count",
        "action_count",
        "actions_completed",
        "actions_terminated",
        "actions_blocked",
        "conclusion_true",
        "conclusion_false",
        "conclusion_inconclusive",
        "diagnostic_count"
      ],
      "properties": {
        "activity_count": {
          "const": 1
        },
        "action_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "actions_completed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "actions_terminated": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "actions_blocked": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "conclusion_true": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "conclusion_false": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "conclusion_inconclusive": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "diagnostic_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        }
      },
      "unevaluatedProperties": false
    }
  }
}
